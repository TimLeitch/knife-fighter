# Copy this file to .env and fill it in. Never commit .env (it holds secrets).

# Port on the server that the site is published on
SITE_PORT=8088

# 1 when a reverse proxy (nginx, Traefik, Caddy) or Cloudflare Tunnel is in front of the site.
# Set 0 if the site is exposed directly to the internet with nothing in front.
TRUST_PROXY=1

# First admin account. Only used on a start where no admin exists yet.
# After the first start you can delete the password from this file.
KG_ADMIN_USER=
KG_ADMIN_PASSWORD=

# 99¢ Supporter Pack through PayPal (see DEPLOY.md, "Taking payments"). Leave these empty to keep the shop off.
# From developer.paypal.com > Apps & Credentials > your app. Start with sandbox (test money): only admins and
# PAYPAL_TESTERS can buy then, and test sales never count once you switch to live with the LIVE app's values.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The ID of the webhook added to that app (refunds, chargebacks, late payments). Required for live.
PAYPAL_WEBHOOK_ID=
# Optional: usernames (comma separated) besides admins who may buy while in sandbox
PAYPAL_TESTERS=

# Only for the optional Cloudflare Tunnel container (docker compose --profile tunnel up -d).
# The token comes from Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > install command.
TUNNEL_TOKEN=
